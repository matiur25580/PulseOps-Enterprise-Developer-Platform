# Local development only. Never commit real credentials.
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

REDIS_PORT=6379

# API
DATABASE_URL=postgresql://pulseops:change-me-local-only@localhost:5432/pulseops?schema=public
API_PORT=4000
# Optional: protect the Prometheus scrape endpoint with a bearer token.
METRICS_TOKEN=
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# OpenTelemetry OTLP/HTTP traces (optional; unset to disable remote export)
OTEL_SERVICE_NAME=pulseops-api
# Base endpoint (the API appends /v1/traces) or set the traces endpoint directly.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional comma-separated HTTP headers, e.g. Authorization=Bearer%20TOKEN
OTEL_EXPORTER_OTLP_HEADERS=
# Root trace sampling ratio from 0 to 1 (default 1.0).
OTEL_TRACES_SAMPLER_ARG=1.0

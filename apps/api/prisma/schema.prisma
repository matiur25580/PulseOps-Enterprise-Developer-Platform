generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceLifecycle {
  EXPERIMENTAL
  PRODUCTION
  DEPRECATED
  RETIRED
}

enum TenantRole {
  ADMIN
  MEMBER
}

model Tenant {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  slug        String                @unique
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  teams       Team[]
  services    Service[]
  memberships TenantMembership[]
  invitations WorkspaceInvitation[]
  auditLogs   AuditLog[]
  incidents   Incident[]
  dependencies ServiceDependency[]
  sloDefinitions SloDefinition[]
  alertRules AlertRule[]
  githubRepositories GitHubRepositoryIntegration[]
  runbookReferences RunbookReference[]
  escalationPolicies EscalationPolicy[]

  @@map("tenants")
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique
  name         String
  passwordHash String             @map("password_hash")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  memberships  TenantMembership[]
  auditLogs     AuditLog[]       @relation("AuditActor")
  assignedIncidents Incident[]   @relation("IncidentAssignee")
  incidentEvents IncidentEvent[] @relation("IncidentEventActor")

  @@map("users")
}

model TenantMembership {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  role      TenantRole @default(MEMBER)
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, role])
  @@map("tenant_memberships")
}

model WorkspaceInvitation {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String
  role            TenantRole @default(MEMBER)
  tokenHash       String     @unique @map("token_hash")
  expiresAt       DateTime   @map("expires_at")
  acceptedAt      DateTime?  @map("accepted_at")
  revokedAt       DateTime?  @map("revoked_at")
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model Team {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  email     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services  Service[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("teams")
}

model Service {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  teamId      String?          @map("team_id") @db.Uuid
  name        String
  slug        String
  description String?
  repository  String?
  lifecycle   ServiceLifecycle @default(EXPERIMENTAL)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  dependenciesFrom ServiceDependency[] @relation("DependencySource")
  dependenciesTo ServiceDependency[] @relation("DependencyTarget")
  sloDefinitions SloDefinition[]
  githubRepositories GitHubRepositoryIntegration[]
  runbooks RunbookReference[]
  escalationPolicy EscalationPolicy?
  incidents Incident[]

  @@unique([tenantId, slug])
  @@index([tenantId, lifecycle])
  @@index([teamId])
  @@map("services")
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model Incident {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  title             String
  description       String?
  serviceId         String?          @map("service_id") @db.Uuid
  escalationLevel   Int              @default(0) @map("escalation_level")
  escalatedAt       DateTime?        @map("escalated_at")
  severity          IncidentSeverity @default(MEDIUM)
  status            IncidentStatus   @default(OPEN)
  assignedToUserId  String?          @map("assigned_to_user_id") @db.Uuid
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  acknowledgedAt    DateTime?        @map("acknowledged_at")
  resolvedAt        DateTime?        @map("resolved_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service            Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignee          User?            @relation("IncidentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  events            IncidentEvent[]

  @@index([tenantId, status, severity])
  @@index([assignedToUserId])
  @@index([tenantId, serviceId])
  @@map("incidents")
}

model IncidentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  eventType   String   @map("event_type")
  message     String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor       User?    @relation("IncidentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_events")
}

enum SloIndicator {
  AVAILABILITY
  LATENCY
}

model ServiceDependency {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  sourceServiceId   String   @map("source_service_id") @db.Uuid
  targetServiceId   String   @map("target_service_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceService     Service  @relation("DependencySource", fields: [sourceServiceId], references: [id], onDelete: Cascade)
  targetService     Service  @relation("DependencyTarget", fields: [targetServiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceServiceId, targetServiceId])
  @@index([tenantId, sourceServiceId])
  @@index([tenantId, targetServiceId])
  @@map("service_dependencies")
}

model SloDefinition {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  serviceId          String       @map("service_id") @db.Uuid
  name               String
  indicator          SloIndicator
  targetPercent      Float        @map("target_percent")
  windowDays         Int          @default(30) @map("window_days")
  latencyThresholdMs Int?         @map("latency_threshold_ms")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service            Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  samples            SliSample[]
  alertRules         AlertRule[]

  @@index([tenantId, serviceId])
  @@map("slo_definitions")
}

model SliSample {
  id         String       @id @default(uuid()) @db.Uuid
  sloId      String       @map("slo_id") @db.Uuid
  success    Boolean
  latencyMs  Int?         @map("latency_ms")
  observedAt DateTime     @default(now()) @map("observed_at")
  slo        SloDefinition @relation(fields: [sloId], references: [id], onDelete: Cascade)

  @@index([sloId, observedAt])
  @@map("sli_samples")
}


model AlertRule {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  sloId               String        @map("slo_id") @db.Uuid
  name                String
  thresholdPercent    Float         @map("threshold_percent")
  cooldownMinutes     Int           @default(30) @map("cooldown_minutes")
  enabled             Boolean       @default(true)
  lastTriggeredAt     DateTime?     @map("last_triggered_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slo                 SloDefinition @relation(fields: [sloId], references: [id], onDelete: Cascade)
  events              AlertEvent[]

  @@index([tenantId, enabled])
  @@index([sloId])
  @@map("alert_rules")
}

model AlertEvent {
  id              String      @id @default(uuid()) @db.Uuid
  ruleId          String      @map("rule_id") @db.Uuid
  incidentId      String?     @map("incident_id") @db.Uuid
  observedPercent Float       @map("observed_percent")
  thresholdPercent Float      @map("threshold_percent")
  message         String
  createdAt       DateTime    @default(now()) @map("created_at")
  rule            AlertRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@map("alert_events")
}


model OutboxEvent {
  id             String    @id @default(uuid()) @db.Uuid
  eventType      String    @map("event_type")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8) @map("max_attempts")
  availableAt    DateTime  @default(now()) @map("available_at")
  lockedAt       DateTime? @map("locked_at")
  processedAt    DateTime? @map("processed_at")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}


model GitHubRepositoryIntegration {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  serviceId         String   @map("service_id") @db.Uuid
  repositoryFullName String @unique @map("repository_full_name")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pullRequests      GitHubPullRequest[]
  deployments       DeploymentRecord[]
  deliveries        GitHubWebhookDelivery[]

  @@unique([tenantId, serviceId])
  @@index([tenantId, active])
  @@map("github_repository_integrations")
}

model GitHubPullRequest {
  id              String   @id @default(uuid()) @db.Uuid
  integrationId   String   @map("integration_id") @db.Uuid
  number          Int
  title           String
  url             String
  state           String
  mergedAt        DateTime? @map("merged_at")
  mergeCommitSha  String?  @map("merge_commit_sha")
  headSha         String   @map("head_sha")
  baseRef         String   @map("base_ref")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  integration     GitHubRepositoryIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, number])
  @@index([integrationId, mergedAt])
  @@index([mergeCommitSha])
  @@map("github_pull_requests")
}

model DeploymentRecord {
  id                String   @id @default(uuid()) @db.Uuid
  integrationId     String   @map("integration_id") @db.Uuid
  githubDeploymentId String @map("github_deployment_id")
  statusId          String   @map("status_id")
  sha               String
  ref               String
  environment       String
  state             String
  deployedAt        DateTime? @map("deployed_at")
  statusUpdatedAt   DateTime @map("status_updated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  integration       GitHubRepositoryIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, githubDeploymentId])
  @@index([integrationId, statusUpdatedAt])
  @@index([integrationId, state, deployedAt])
  @@index([sha])
  @@map("deployment_records")
}

model GitHubWebhookDelivery {
  id                String   @id @default(uuid()) @db.Uuid
  deliveryId        String   @unique @map("delivery_id")
  integrationId     String   @map("integration_id") @db.Uuid
  eventName         String   @map("event_name")
  action            String?
  receivedAt        DateTime @default(now()) @map("received_at")
  integration       GitHubRepositoryIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, receivedAt])
  @@map("github_webhook_deliveries")
}


model RunbookReference {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  title     String
  url       String
  category  String   @default("RUNBOOK")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, title])
  @@index([tenantId, serviceId])
  @@map("runbook_references")
}

model EscalationPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  serviceId             String   @map("service_id") @db.Uuid
  primaryContactEmail   String   @map("primary_contact_email")
  secondaryContactEmail String?  @map("secondary_contact_email")
  escalationAfterMinutes Int    @default(15) @map("escalation_after_minutes")
  onCallUrl             String?  @map("on_call_url")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceId])
  @@index([tenantId])
  @@map("escalation_policies")
}
